# BOKA OS — Environment Configuration
# Copy this file to .env and fill in your values

# Database (SQLite — default, no setup needed)
DATABASE_URL=file:./db/custom.db

# Auth — set any non-empty password to enable login
# When unset → auth DISABLED (all endpoints public — dev mode only!)
# BOKA_ACCESS_PASSWORD=your_password_here

# CLI Execution — set to 1 to enable shell commands via /api/mcp/cli
# Disabled by default for security
# BOKA_ENABLE_CLI=1

# AI Provider (optional — defaults to openrouter)
# Options: openrouter | ollama | gguf | custom
# BOKA_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Ollama (local LLM)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Whisper (ASR)
# WHISPER_URL=http://127.0.0.1:5100
# WHISPER_MODEL=medium
